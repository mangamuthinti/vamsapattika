# Django Backend API URL
# Development: http://localhost:8000/api
# Production: https://your-backend-domain.com/api
VITE_API_URL=http://localhost:8000/api

# Razorpay Public Key ID
# Get from: https://dashboard.razorpay.com/app/keys
# Use TEST key for development (starts with rzp_test_)
# Use LIVE key for production (starts with rzp_live_)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Google OAuth Client ID
# Get from: https://console.cloud.google.com/
# Make sure to add authorized origins:
# - http://localhost:5173 (development)
# - https://your-domain.com (production)

# Note: All Vite environment variables MUST start with VITE_ prefix
# to be accessible in the application via import.meta.env
